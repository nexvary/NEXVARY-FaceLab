# Core self-hosted generation. No paid API key is required.
ENABLE_GENERATIVE=1
FACE_DIFFUSION_MODEL=stable-diffusion-v1-5/stable-diffusion-inpainting
FACE_AI_STEPS=24
FACE_AI_GUIDANCE=7.0
FACE_AI_SEED=424242

# Optional reference hairstyle via IP-Adapter.
# Enable only after you review the exact adapter/model weight licenses you deploy.
ENABLE_IP_ADAPTER=0
FACE_IP_ADAPTER_REPO=h94/IP-Adapter
FACE_IP_ADAPTER_SUBFOLDER=models
FACE_IP_ADAPTER_WEIGHT=ip-adapter_sd15.bin
FACE_IP_ADAPTER_SCALE=0.65

# Optional GFPGAN local clone.
# GFPGAN_REPO=C:\AI\GFPGAN

# Stage 900 storage root (recommended: point this to the new large disk)
# FACELAB_DATA_ROOT=D:\\NEXVARY-AI

# Optional local Virtual Try-On command adapter. Placeholders: {person} {garment} {category} {output}
# FASHN_VTON_COMMAND=python C:\\AI\\fashn-vton\\run_local.py --person {person} --garment {garment} --category {category} --output {output}
# FASHN_VTON_TIMEOUT=900

# Stage 4000 — local short-film engines and render queue.
# Point these to locally installed, license-audited model snapshots/executables.
FACELAB_COGVIDEOX_DIR=
FACELAB_LTX_VIDEO_DIR=
FACELAB_MUSETALK_DIR=
FACELAB_FFMPEG=

# Real Stage 4000 MP4 preview uses FFmpeg when available.
# FACELAB_FILM_PREVIEW_SECONDS=12
# FACELAB_FILM_WORKERS=1
# FACELAB_FILM_DIR=D:\\NEXVARY-AI\\film-jobs

# Optional audited local AI image-to-video adapter. JSON array; NO shell is used.
# Placeholders: {input} {output} {prompt} {duration} {preset}
# FACELAB_VIDEO_ENGINE_CMD_JSON=["python","D:/AI/video-engine/render.py","--image","{input}","--prompt","{prompt}","--seconds","{duration}","--output","{output}"]
# FACELAB_VIDEO_ENGINE_TIMEOUT=1800

# Stage 11000 - Motion Studio / private friends profile
# FACELAB_LIVEPORTRAIT_DIR=D:\NEXVARY-AI\LivePortrait
# FACELAB_MIMICMOTION_DIR=D:\NEXVARY-AI\MimicMotion
# FACELAB_DRIVING_MOTIONS_DIR=D:\NEXVARY-AI\driving-motions
# FACELAB_MIMIC_CKPT=D:\NEXVARY-AI\MimicMotion\models\MimicMotion_1-1.pth
# The *_CMD_JSON values are set automatically by configure_stage11000_motion_windows.bat.
